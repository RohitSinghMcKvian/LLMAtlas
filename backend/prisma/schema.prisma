generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String?
  password      String
  avatarUrl     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  conversations Conversation[]
  preferences   UserPreference?
  bookmarks     Bookmark[]
}

model Conversation {
  id        String   @id @default(cuid())
  userId    String
  title     String
  models    String   @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  Message[]
  
  @@index([userId])
  @@index([updatedAt])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  role           String
  content        String
  modelId        String?
  order          Int
  
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  
  @@index([conversationId])
  @@index([order])
}

model Model {
  id                  String    @id @default(cuid())
  name                String
  organization        String
  version             String?
  description         String
  parameters          String?
  activeParameters    String?
  architecture        String?
  contextWindow       Int       @default(128000)
  maxOutputTokens     Int       @default(4096)
  trainingCutoff      String?
  trainingTokens     String?
  modalitiesInput     String    @default("[]")
  modalitiesOutput    String    @default("[]")
  languagesSupported String?
  toolUse            String    @default("No")
  systemPrompt       String    @default("Supported")
  fineTuning         String    @default("Not available")
  license           String
  releaseDate        String?
  organizationLink  String?
  apiEndpoint       String?
  huggingfaceRepo  String?
  github           String?
  paper            String?
  vramBF16         String?
  vramQ4           String?
  quantizationFormats String    @default("[]")
  selfHostable     Boolean   @default(false)
  pricing          String?
  strengths        String    @default("[]")
  status           String    @default("Available")
  isOpenSource     Boolean   @default(false)
  family           String?
  apiAvailable     Boolean   @default(true)
  
  openrouterId      String?
  hfDownloads       Int       @default(0)
  hfLikes           Int       @default(0)
  hfTags            String    @default("[]")
  pricingInput      Float?
  pricingOutput     Float?
  libraryName       String?
  pipelineTag       String?
  
  benchmarkScores   BenchmarkScore[]
  versions         ModelVersion[]
  
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  
  @@index([organization])
  @@index([license])
  @@index([status])
}

model Benchmark {
  id               String    @id @default(cuid())
  name             String
  shortName        String?
  category        String
  description     String
  whyItMatters    String
  limitations     String
  methodologyUrl  String?
  scoreType       String    @default("percentage")
  higherIsBetter  Boolean   @default(true)
  scaleMin        Float     @default(0)
  scaleMax        Float     @default(100)
  sourceUrl       String?
  
  scores          BenchmarkScore[]
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  @@index([category])
}

model BenchmarkScore {
  id            String    @id @default(cuid())
  modelId       String
  benchmarkId   String
  score         Float
  runCount      Int       @default(1)
  source        String    @default("Official")
  evalDate      String?
  
  model         Model     @relation(fields: [modelId], references: [id], onDelete: Cascade)
  benchmark     Benchmark @relation(fields: [benchmarkId], references: [id], onDelete: Cascade)
  
  createdAt     DateTime  @default(now())
  
  @@unique([modelId, benchmarkId])
  @@index([modelId])
  @@index([benchmarkId])
}

model ModelVersion {
  id            String    @id @default(cuid())
  modelId       String
  version       String
  releaseDate   String?
  changelog     String?
  deprecatedBy  String?
  
  model         Model     @relation(fields: [modelId], references: [id], onDelete: Cascade)
  
  createdAt     DateTime  @default(now())
  
  @@index([modelId])
}

model NewsItem {
  id          String    @id @default(cuid())
  title       String
  summary     String
  url         String
  source      String
  sourceIcon  String?
  tags        String    @default("[]")
  publishedAt DateTime
  fetchedAt   DateTime  @default(now())
  
  @@index([publishedAt])
}

model SyncLog {
  id            String    @id @default(cuid())
  jobName       String
  ranAt         DateTime  @default(now())
  itemsUpdated Int       @default(0)
  errors       String?
  status       String    @default("success")
}

model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  type      String
  itemId    String
  createdAt DateTime @default(now())
  
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([userId, type, itemId])
  @@index([userId])
}

model UserPreference {
  id              String   @id @default(cuid())
  userId          String   @unique
  skillLevel     String?
  bookmarks      String    @default("[]")
  recentViews    String    @default("[]")
  theme          String   @default("dark")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LeaderboardEntry {
  id          String   @id @default(cuid())
  modelName   String
  modelId     String?
  organization String
  category    String   @default("text")
  arenaScore  Float
  ci95Lower   Float
  ci95Upper   Float
  votes       Int      @default(0)
  license     String   @default("Unknown")
  rank        Int
  lastUpdated DateTime @default(now())
  
  @@unique([modelName, category])
  @@index([category])
  @@index([organization])
  @@index([rank])
}